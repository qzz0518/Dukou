<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>Dukou</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.dukou.Dukou</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Dukou</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.2</string>
	<!-- The only caller is Dukou's own 「发送到自定义」 extension: with an empty
	     target list it has to hand the user over to the settings window, and an
	     app extension cannot use NSWorkspace to open anything. See
	     Sources/DukouCore/AppLink.swift. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.dukou.Dukou</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dukou</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>3</string>
	<!-- The app group container both bundles read. Kept in Info.plist rather
	     than hard-coded in Swift so one build-script substitution can retarget
	     the app and its extension together. -->
	<key>DKAppGroupIdentifier</key>
	<string>H2P566W3PA.dev.dukou.shared</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- A resident receiver, not a document app: the share extension launches it
	     in the background, where a Dock icon would only be noise. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>本地文件中转工具，不解压也不上传分享内容。</string>
	<!-- Sparkle. The feed is a signed appcast on GitHub Pages, and the DMG it
	     points at is the same notarised file GitHub Releases serves. The key
	     is the EdDSA public half; the private half lives only in the
	     maintainer's keychain. Automatic checks are declared rather than asked
	     for: the share extension starts this app in the background over
	     WeChat, and Sparkle's permission prompt would otherwise be the first
	     window a new user ever saw from Dukou. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://qzz0518.github.io/Dukou/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>ewhB3/oxtZ9y5jnrq3YiESbieGCF/XfRIMwOb94lYdE=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
